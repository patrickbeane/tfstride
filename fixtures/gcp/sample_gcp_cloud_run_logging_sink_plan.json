{
  "format_version": "1.2",
  "terraform_version": "1.8.5",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "google_cloud_run_v2_service.api",
          "mode": "managed",
          "type": "google_cloud_run_v2_service",
          "name": "api",
          "provider_name": "registry.terraform.io/hashicorp/google",
          "values": {
            "name": "tfstride-api",
            "project": "tfstride-demo",
            "location": "us-central1",
            "ingress": "INGRESS_TRAFFIC_ALL",
            "uri": "https://tfstride-api.run.app",
            "template": [
              {
                "service_account": "tfstride-run@tfstride-demo.iam.gserviceaccount.com",
                "containers": [
                  {
                    "name": "api",
                    "env": [
                      {
                        "name": "DB_PASSWORD",
                        "value_source": [
                          {
                            "secret_key_ref": [
                              {
                                "secret": "projects/tfstride-demo/secrets/tfstride-api-key",
                                "version": "5"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "address": "google_cloud_run_v2_service_iam_member.public_invoker",
          "mode": "managed",
          "type": "google_cloud_run_v2_service_iam_member",
          "name": "public_invoker",
          "provider_name": "registry.terraform.io/hashicorp/google",
          "values": {
            "name": "tfstride-api",
            "project": "tfstride-demo",
            "location": "us-central1",
            "role": "roles/run.invoker",
            "member": "allUsers"
          }
        },
        {
          "address": "google_logging_project_sink.audit",
          "mode": "managed",
          "type": "google_logging_project_sink",
          "name": "audit",
          "provider_name": "registry.terraform.io/hashicorp/google",
          "values": {
            "id": "projects/tfstride-demo/sinks/audit-export",
            "name": "audit-export",
            "project": "tfstride-demo",
            "destination": "storage.googleapis.com/tfstride-audit-archive",
            "filter": "(logName=\"projects/tfstride-demo/logs/cloudaudit.googleapis.com%2Factivity\" OR logName=\"projects/tfstride-demo/logs/cloudaudit.googleapis.com%2Fdata_access\")",
            "writer_identity": "serviceAccount:logging-tfstride-demo@gcp-sa-logging.iam.gserviceaccount.com",
            "unique_writer_identity": true,
            "disabled": false
          }
        },
        {
          "address": "google_logging_project_sink.errors",
          "mode": "managed",
          "type": "google_logging_project_sink",
          "name": "errors",
          "provider_name": "registry.terraform.io/hashicorp/google",
          "values": {
            "id": "projects/tfstride-demo/sinks/error-export",
            "name": "error-export",
            "project": "tfstride-demo",
            "destination": "storage.googleapis.com/tfstride-audit-archive",
            "filter": "logName:\"cloudaudit.googleapis.com\" AND severity>=ERROR",
            "writer_identity": "serviceAccount:logging-tfstride-demo@gcp-sa-logging.iam.gserviceaccount.com",
            "unique_writer_identity": true,
            "disabled": false
          }
        },
        {
          "address": "google_logging_project_sink.negated",
          "mode": "managed",
          "type": "google_logging_project_sink",
          "name": "negated",
          "provider_name": "registry.terraform.io/hashicorp/google",
          "values": {
            "id": "projects/tfstride-demo/sinks/app-export",
            "name": "app-export",
            "project": "tfstride-demo",
            "destination": "storage.googleapis.com/tfstride-app-logs",
            "filter": "NOT logName:\"cloudaudit.googleapis.com\"",
            "writer_identity": "serviceAccount:logging-tfstride-demo@gcp-sa-logging.iam.gserviceaccount.com",
            "unique_writer_identity": true,
            "disabled": false
          }
        },
        {
          "address": "google_project_iam_member.run_logging_admin",
          "mode": "managed",
          "type": "google_project_iam_member",
          "name": "run_logging_admin",
          "provider_name": "registry.terraform.io/hashicorp/google",
          "values": {
            "project": "tfstride-demo",
            "role": "roles/logging.admin",
            "member": "serviceAccount:tfstride-run@tfstride-demo.iam.gserviceaccount.com"
          }
        }
      ]
    }
  }
}
